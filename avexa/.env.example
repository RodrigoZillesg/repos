# Banco
DATABASE_URL=postgres://avexa:avexa@localhost:5432/avexa

# E-mail — conexão única da Avexa, domínio verificado no Resend
RESEND_API_KEY=
EMAIL_REMETENTE="Avexa <contato@avexa.global>"

# WhatsApp — WABA da marca Avexa
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# SMS e telefonia — mesmo número atende os dois, para o lead reconhecer a origem
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_REMETENTE=
TWILIO_STATUS_CALLBACK=https://hooks.avexa.global/api/webhooks/twilio

# Voz com IA
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# Modelo de linguagem — plugável, Gemini como default
IA_PROVEDOR=gemini
GEMINI_API_KEY=
IA_MODELO=gemini-2.5-flash

# Chave da aplicacao: cifra os segredos de integracao em repouso (AES-256-GCM).
# Minimo 32 caracteres. Trocar esta chave torna ilegiveis os segredos ja
# gravados, e cada cliente precisa reconectar.
APP_SECRET=

# Google Workspace — cada cliente conecta a propria conta pelo painel
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://new.avexa.global/api/integracoes/google/retorno

# Calendly — alternativa ao Google Calendar. Quem escolhe o horário é o lead, por
# um link de uso único; a reunião só existe quando o webhook confirma. Sem
# CALENDLY_SIGNING_KEY a rota de webhook recusa tudo, de propósito: um webhook
# aberto deixaria qualquer um inventar reunião no painel do cliente. A chave sai
# na criação da assinatura de webhook, em Webhooks da conta.
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_REDIRECT_URI=https://new.avexa.global/api/integracoes/calendly/retorno
CALENDLY_SIGNING_KEY=

# HubSpot — cada cliente conecta o próprio portal pelo painel. App público com
# os escopos de contato e de esquema de contato; nada de token de private app,
# que alguém teria de colar aqui e passaria a circular por e-mail.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=https://new.avexa.global/api/integracoes/hubspot/retorno

# Base das URLs de entrada de lead. O provisionamento monta
# <HOOKS_BASE_URL>/<cliente>/<fluxo> e entrega isso ao cliente.
HOOKS_BASE_URL=https://hooks.avexa.global/v1

WORKER_CONCORRENCIA=5
