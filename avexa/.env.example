# Banco
DATABASE_URL=postgres://avexa:avexa@localhost:5432/avexa

# E-mail — conexão única da Avexa, domínio verificado no Resend
RESEND_API_KEY=
EMAIL_REMETENTE="Avexa <contato@avexa.global>"

# WhatsApp — WABA da marca Avexa
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# SMS e telefonia — mesmo número atende os dois, para o lead reconhecer a origem
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_REMETENTE=
TWILIO_STATUS_CALLBACK=https://app.avexa.global/api/webhooks/twilio

# Voz com IA
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# Modelo de linguagem — plugável, Gemini como default
IA_PROVEDOR=gemini
GEMINI_API_KEY=
IA_MODELO=gemini-2.5-flash

WORKER_CONCORRENCIA=5
